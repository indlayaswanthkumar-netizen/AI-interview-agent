# Database
# For local SQLite development (default) or PostgreSQL:
# PostgreSQL: postgresql://postgres:password@localhost:5432/interviewai?schema=public
DATABASE_URL="file:./dev.db"

# Authentication secret (Generate a strong 32+ char secret in production)
AUTH_SECRET="dev-secret-interview-ai-token-change-in-production-min-32-chars"

# AI Provider Settings
# Options: "openai" (requires valid OPENAI_API_KEY) or "demo" (mock AI provider for keyless testing)
AI_PROVIDER="demo"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
